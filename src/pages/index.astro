---
import Layout from "../layouts/Layout.astro";
import "../styles/home.css";

import { getCollection } from "astro:content";

const works = await getCollection("works");
// 作品の制作時期は年のみのため、同じ年の作品はID順に並べて表示順を固定します。
const recentWorks = works
    .sort((a, b) => b.data.year - a.data.year || a.id.localeCompare(b.id, "en"))
    .slice(0, 3);
---

<Layout title="KIKU — Portfolio">

    <!-- Hero -->

    <section class="hero">

        <div class="hero-top">
            <span>GAME DEVELOPER</span>
            <span>HCI RESEARCHER</span>
        </div>

        <div class="hero-main">

            <h1>
                <span class="hero-title-line">CREATE</span>
                <br />
                <span class="hero-title-line hero-title-line--muted">INTERACTION</span>
                <br />
                <span class="hero-title-line">THAT FEELS.</span>
            </h1>

        </div>

        <div class="hero-bottom">
            <span>PORTFOLIO / 2026</span>
            <span>SCROLL TO EXPLORE ↓</span>
        </div>

        <div class="hero-image">
            <img src="../images/icons/icon.jpg"alt="KIKU portfolio hero image"/>
        </div>

    </section>


    <!-- About -->

    <section id="about" class="about">

        <div class="section-label">
            <span>01</span>
            <span>ABOUT</span>
        </div>

        <div class="about-content">

            <h2>
                Play,
                <br />
                interaction,
                <br />
                exploration.
            </h2>

            <div class="about-text">

                <p>
                    ゲーム制作やHCIについて研究している
                    コンピュータ理工学科の学生です。
                </p>

                <p>
                    「人とコンピュータの間にある体験」に興味があり、
                    ゲームやインタラクションを通して、
                    使っていて楽しいデジタル体験を考えています。
                </p>

                <a href="/about/" class="text-link">MORE ABOUT ME →</a>

            </div>

        </div>

    </section>


    <!-- Works -->

    <section id="works" class="works">

        <div class="section-label">
            <span>02</span>
            <span>RECENT WORKS</span>
        </div>

        <div class="works-content">

            <div class="works-heading">

                <h2>
                    Recent
                    <br />
                    Works.
                </h2>

                <a href="/works/" class="text-link">VIEW ALL WORKS →</a>

            </div>


            <div>

                <div class="featured-works" id="featured-works">

                    {
                        recentWorks.map((work, index) => (

                            <a
                                href={`/works/${work.id}/`}
                                class="featured-work is-visible"
                            >

                                <div class="work-image">

                                    <img src={work.data.image} alt={work.data.title}/>

                                    <span class="work-arrow">
                                        ↗
                                    </span>

                                </div>

                                <div class="work-info">

                                    <div>

                                        <h3>{work.data.title}</h3>

                                        <p>{work.data.description}</p>

                                    </div>

                                    <div class="work-meta">

                                        <span>{work.data.year}</span>

                                        <span>{work.data.technologies.join(" / ")}</span>

                                    </div>

                                </div>

                            </a>

                        ))
                    }

                </div>




            </div>

        </div>

    </section>


    <!-- Contact -->

    <section id="contact" class="contact">

        <div class="section-label">

            <span>03</span>
            <span>CONTACT</span>

        </div>

        <div class="contact-content">

            <p class="contact-label">HAVE A PROJECT?</p>

            <h2>
                LET'S
                <br />
                TALK.
            </h2>

            <a href="https://X.com/kikukikukiku333" target="_blank" rel="noopener noreferrer" class="contact-link">
                X ↗
            </a>

        </div>

    </section>

</Layout>


<script>
    import { initScrollReveal } from "../scripts/scroll-reveal";

    initScrollReveal(
        ".about .section-label, .about-content h2, .about-text > *, " +
        ".works .section-label, .works-heading > *, .featured-work, " +
        ".statement p, .contact .section-label, .contact-content > *",
    );
</script>
