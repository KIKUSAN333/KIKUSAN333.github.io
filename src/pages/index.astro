---
import Layout from "../layouts/Layout.astro";
import "../styles/home.css";

import { getCollection } from "astro:content";

const works = await getCollection("works");
---

<Layout title="Home">

    <!-- Hero -->
    <section class="hero">
        <p class="hero-name">KIKU</p>

        <h1>Game Developer</h1>

        <p class="hero-description">ゲーム制作やHCIについて研究している一般人です。</p>
    </section>


    <!-- Works -->
    <section>

        <div class="section-header">
            <h2>Featured Works</h2>

            <a href="/works/">View all works →</a>
        </div>

        <div class="featured-works" id="featured-works">

            {works.map((work) => (
                <a href={`/works/${work.id}/`} class="featured-work">
                    <img src={work.data.image} alt={work.data.title} />

                    <h3>{work.data.title}</h3>

                    <p>{work.data.description}</p>
                </a>
            ))}

        </div>

        <div class="featured-controls">
            <button id="prev-works">← 前へ</button>
            <button id="next-works">次へ →</button>
        </div>

    </section>

</Layout>


<script>
    const cards = Array.from(
        document.querySelectorAll(".featured-work")
    );

    const nextButton = document.querySelector("#next-works");
    const prevButton = document.querySelector("#prev-works");

    const displayCount = 3;
    const intervalTime = 5000;

    let currentIndex = 0;

    // 作品の表示を更新する関数
    function showWorks() {

        cards.forEach((card, index) => {

            const relativeIndex = (index - currentIndex + cards.length) % cards.length;

            if (relativeIndex < displayCount) {
                card.classList.add("is-visible");
            } else {
                card.classList.remove("is-visible");
            }

        });

    }

    // ボタンのクリックイベントを設定
    function nextWorks() {

        currentIndex = (currentIndex + displayCount) % cards.length;

        showWorks();

    }

    nextButton?.addEventListener("click", nextWorks);

    function prevWorks() {

        currentIndex = (currentIndex - displayCount + cards.length) % cards.length;

        showWorks();

    }

    prevButton?.addEventListener("click", prevWorks);

    // 作品表示
    showWorks();

    setInterval(() => {nextWorks();}, intervalTime);
</script>