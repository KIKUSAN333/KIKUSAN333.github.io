---
import Layout from "../../layouts/Layout.astro";
import "../../styles/work-detail.css";

import { getCollection, render } from "astro:content";

export async function getStaticPaths() {

    const works = await getCollection("works");

    return works.map((work) => ({
        params: {
            slug: work.id
        },

        props: {
            work
        }
    }));
}

const { work } = Astro.props;

const { Content } = await render(work);
---

<Layout title={work.data.title}>

    <article class="work-detail">


        <!-- Header -->

        <header class="work-header">

            <div class="work-header-top">

                <span>WORK / {work.data.year}</span>

                <a href="/works/">
                    ALL WORKS ↗
                </a>

            </div>


            <h1>
                {work.data.title}
            </h1>


            <div class="work-header-bottom">

                <p class="work-description">
                    {work.data.description}
                </p>


                <div class="work-meta">

                    <span>TECHNOLOGIES</span>

                    <ul>
                        {
                            work.data.technologies.map((technology) => (
                                <li>{technology}</li>
                            ))
                        }
                    </ul>

                </div>

            </div>

        </header>


        <!-- Main Image -->

        <div class="work-image">

            <img src={work.data.image} alt={work.data.title}/>

        </div>

        <div>
            
        </div>


        <!-- Content -->

        <div class="work-content">
            
            <h2>{work.data.title}</h2>

            <Content />

        </div>


        <!-- Bottom Navigation -->

        <div class="work-footer">

            <a href="/works/" class="back-link">← BACK TO WORKS</a>

        </div>


    </article>

</Layout>