---
import "../styles/site-intro.css";
import introScript from "../scripts/site-intro.js?raw";
---

<div id="site-intro" aria-hidden="true">
    <div class="composition">
        <span class="piece panel upper-left"></span>
        <span class="piece panel upper-center"></span>
        <span class="piece panel upper-right"></span>
        <span class="piece panel lower-left"></span>
        <span class="piece panel lower-center"></span>
        <span class="piece panel lower-right"></span>
        <span class="piece upper-chevron"></span>
        <span class="piece left-inset"></span>
        <span class="piece left-wedge"></span>
        <span class="piece left-triangle"></span>
        <span class="piece top-triangle"></span>
        <span class="piece center-disc"></span>
        <span class="piece disc"></span>
        <span class="piece lower-disc"></span>
        <span class="piece light-disc"></span>
        <span class="piece right-rhombus"></span>
        <span class="piece lower-left-wedge"></span>
        <span class="piece bottom-triangle"></span>
        <span class="piece bottom-slat"></span>
        <span class="piece right-wedge"></span>
        <span class="piece bolt"></span>
    </div>
</div>

<script is:inline set:html={introScript}></script>
